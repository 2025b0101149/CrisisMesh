# Server Configuration
PORT=5000
NODE_ENV=development

# Client / Frontend URL (for CORS allowlist)
# Example for Production: FRONTEND_URL=https://crisismesh.vercel.app
# Example for Local Dev: FRONTEND_URL=http://localhost:5173
FRONTEND_URL=http://localhost:5173
CLIENT_URL=http://localhost:5173

# Database Configuration (MongoDB Atlas or Local MongoDB)
# For Render deployment, configure this in the Render dashboard:
# MONGO_URI=mongodb+srv://<username>:<password>@cluster0.xxxxx.mongodb.net/crisismesh?retryWrites=true&w=majority
MONGO_URI=mongodb://localhost:27017/crisismesh

# Authentication (JWT)
JWT_SECRET=your_jwt_secret_key_change_in_production
JWT_EXPIRES_IN=7d

# AI Integration (Google Gemini API)
GEMINI_API_KEY=your_gemini_api_key_here

# Mapping / Geospatial Services (Mapbox or Google Maps)
MAPBOX_ACCESS_TOKEN=your_mapbox_access_token_here
GOOGLE_MAPS_API_KEY=your_google_maps_api_key_here
