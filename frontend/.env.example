# CrisisMesh Frontend Environment Variables

# Backend Public API URL (Render or custom domain)
# Example for Production: VITE_API_URL=https://crisismesh-api.onrender.com
# Example for Local Dev: VITE_API_URL=http://localhost:5000
VITE_API_URL=https://crisismesh-api.onrender.com
VITE_API_BASE_URL=http://localhost:5000/api

# AI Service (If client-side calling is ever enabled, otherwise handled securely via backend)
# VITE_GEMINI_API_KEY=your_gemini_api_key

# Mapping Services (Client-side token for map rendering)
VITE_MAPBOX_TOKEN=your_mapbox_token_here
VITE_GOOGLE_MAPS_KEY=your_google_maps_key_here
